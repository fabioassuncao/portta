{
  "name": "portta-web",
  "version": "0.1.0",
  "private": true,
  "description": "Administration panel for Portta",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--conditions=development tsx watch --clear-screen=false server/main.ts",
    "build": "next build && tsx esbuild.server.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "npm run build && node e2e/screenshots.mjs",
    "viewports": "npm run build && node e2e/viewports.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.2",
    "@hono/node-server": "2.1.1",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.2",
    "i18next": "^26.4.1",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "portta-auth-core": "0.1.0",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "portta-db": "0.1.0",
    "portta-server": "0.1.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.13",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "jsdom": "28.1.0",
    "markdown-it": "^14.1.0",
    "mermaid": "11.17.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
