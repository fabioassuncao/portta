PORTTA_DOMAIN=localhost
TLS_ENABLED=false
TS_AUTHKEY=fixture-value-never-returned
# The panel reads its own `.env` for the diagnostics that are about the file
# rather than about the process: a secret that exists only in the environment
# is a secret the next `up` would regenerate.
PORTTA_AUTH_SECRET=a-fixture-secret-long-enough-to-sign
