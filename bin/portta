#!/usr/bin/env bash
# ============================================================================
# portta: operational entrypoint for Portta
# ============================================================================
# Portta is shared host infrastructure. It never owns, moves, starts
# or stops a consumer project: every command here acts only on resources
# labelled `portta.managed=true`.
# ============================================================================

set -euo pipefail

# Resolved through symlinks: the installer puts one in /usr/local/bin, and
# without this the libraries would be looked for next to the link.
_portta_entry="${BASH_SOURCE[0]}"
while [ -L "$_portta_entry" ]; do
  _portta_dir=$(cd -P "$(dirname "$_portta_entry")" && pwd)
  _portta_entry=$(readlink "$_portta_entry")
  case "$_portta_entry" in
    /*) ;;
    *) _portta_entry="$_portta_dir/$_portta_entry" ;;
  esac
done
PORTTA_BIN_DIR=$(cd -P "$(dirname "$_portta_entry")" && pwd)
unset _portta_entry _portta_dir

# The full CLI is TypeScript. Keep this tiny entry point because a bare host
# must still be able to bootstrap, start, stop, inspect status and run doctor
# without Node (ADR 0015). Shell-native drivers can deliberately set
# PORTTA_FORCE_BASH when the TypeScript command delegates to openssl/ssh/toolbox.
# This entry point knows which installation it belongs to; the TypeScript CLI
# would otherwise have to guess from the working directory, and would not find
# a PORTTA_HOME outside the conventional locations.
if [ -z "${PORTTA_ROOT:-}" ] && [ -f "$PORTTA_BIN_DIR/../VERSION" ]; then
  PORTTA_ROOT=$(cd -P "$PORTTA_BIN_DIR/.." && pwd)
  export PORTTA_ROOT
fi

PORTTA_TS_CLI="${PORTTA_TS_CLI:-$PORTTA_BIN_DIR/../packages/cli/dist/cli.js}"
# An installed PORTTA_HOME has no packages/ directory, and its bin/portta is
# linked onto PATH, where it would otherwise shadow a globally installed
# `portta` npm package and quietly give the reduced command set. npm puts a
# global package in lib/node_modules next to the node binary's own directory.
if [ ! -f "$PORTTA_TS_CLI" ] && command -v node >/dev/null 2>&1; then
  _portta_node_prefix=$(dirname "$(dirname "$(command -v node)")")
  if [ -f "$_portta_node_prefix/lib/node_modules/portta/dist/cli.js" ]; then
    PORTTA_TS_CLI="$_portta_node_prefix/lib/node_modules/portta/dist/cli.js"
  fi
  unset _portta_node_prefix
fi
if [ "${PORTTA_FORCE_BASH:-false}" != "true" ] \
   && command -v node >/dev/null 2>&1 \
   && [ -f "$PORTTA_TS_CLI" ] \
   && node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=12)?0:1)' >/dev/null 2>&1; then
  exec node "$PORTTA_TS_CLI" "$@"
fi
# shellcheck source=../scripts/lib/common.sh
. "$PORTTA_BIN_DIR/../scripts/lib/common.sh"
# shellcheck source=../scripts/lib/docker.sh
. "$PORTTA_BIN_DIR/../scripts/lib/docker.sh"
# shellcheck source=../scripts/lib/toolbox.sh
. "$PORTTA_BIN_DIR/../scripts/lib/toolbox.sh"
# shellcheck source=../scripts/lib/discovery.sh
. "$PORTTA_BIN_DIR/../scripts/lib/discovery.sh"
# shellcheck source=../scripts/lib/apply.sh
. "$PORTTA_BIN_DIR/../scripts/lib/apply.sh"
# shellcheck source=../scripts/lib/runner.sh
. "$PORTTA_BIN_DIR/../scripts/lib/runner.sh"
# shellcheck source=../scripts/lib/auth.sh
. "$PORTTA_BIN_DIR/../scripts/lib/auth.sh"


portta_load_env
portta_defaults

PORTTA_ASSUME_YES="${PORTTA_ASSUME_YES:-false}"

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'PORTTA_HELP'
portta: shared HTTP/TCP gateway for parallel Docker development

USAGE
  portta <command> [arguments] [flags]

CORE
  bootstrap              Prepare this host: check the runtime, create the shared
                         network and state directories, then run doctor
  build                  Build every local Portta image tagged from VERSION
  up [profile]           Start the gateway (profile: local | remote-private | remote-public)
  dev [profile]          Checkout setup: build Portta images locally, start the panel
  down                   Stop the gateway. Consumer projects keep running
  reset                  Wipe the panel database and restart this checkout as if it were new
  restart                Restart gateway components
  status                 Compact overview of the running gateway
  logs [service]         Follow gateway logs
  doctor                 Deep diagnostics and suggested fixes
  urls                   List the hostnames currently routed by the gateway
  inspect                Print the resolved configuration and compose files
  update                 Pull the pinned component images and recreate
  version                Print the gateway version

MAINTENANCE
  backup [-o <file>]     Archive everything this installation cannot regenerate
  restore <file>         Put a backup back, keeping what it replaced
  repair [--dry-run]     Recreate what is missing and fix what is provably wrong
  tunnel setup|enable    Publish over HTTPS with no open port (Cloudflare Tunnel)
  tunnel status|test     Inspect the connector and confirm it carries traffic

CONFIGURATION
  config list            Named settings and their current values
  config get <setting>   One setting
  config set <s> <v>     Change one setting and apply it, for example:
                           config set panel.access public|tailscale|local

WEB PANEL
  web up                 Start the administration panel (loopback by default)
  web open|status|logs   Reach it, inspect it, follow it
  web down|disable       Stop it; the gateway keeps running

TCP SERVICES (databases, caches, queues)
  services               Every service of every running project, and how to reach it
  access open            Open a loopback bridge to a private TCP service
  access list|close|gc   Manage those bridges
  db status|shell        Inspect or open the panel's private PostgreSQL
  db dump|restore        Back up or restore persisted panel data
  db psql | redis cli    Run a client inside the project's own network
  db open | redis open   Open a bridge for a GUI client
  service publish        Give a TCP service a persistent private address

NETWORK AND EXPOSURE
  network status         Interfaces, binds, listeners and what is reachable
  public status          Show internet exposure (disabled by default)
  public enable          Expose HTTP services on the public wildcard domain
  public disable         Stop exposing them
  share list|revoke|gc   Temporary hostnames the panel handed out, and their expiry
  auth protect|status    Put Portta login in front of a project hostname
  dns check              Confirm the wildcard record points at this host
  dns status             DNS configuration, and Cloudflare records if enabled
  dns setup              Create or update the wildcard record
  tls status             TLS configuration and certificates
  tls init               Create a local CA and certificate for local HTTPS
  tls trust              How to trust the local CA on this machine

REMOTE HOSTS
  remote bootstrap <user@host>   Prepare a host and start the gateway there
  remote status|doctor|urls <user@host>
  remote exec <user@host> -- <command>

WHAT AN ENVIRONMENT IS RUNNING
  git scan               Collect each project's branch, HEAD and dirty state
  git status             What was collected, and how old it is
  host collect           One host and project metrics snapshot into state/metrics
  host watch             Keep collecting (started by up)
  host status            Whether the collector is running, and how old the last snapshot is

ADOPTING A PROJECT
  analyze <path>         Read-only report on how a project would adopt the gateway
  init <path>            Generate the integration overlay (asks before writing)
  namespace              Derive a COMPOSE_PROJECT_NAME for this worktree

TOOLBOX
  toolbox build          Build the container holding curl, jq, dig, psql, ...
  toolbox run -- <cmd>   Run a command inside it

FLAGS
  -h, --help             Show help for the command
      --json             Machine-readable output (status, doctor, urls)
      --profile <name>   Override the profile for this invocation
  -y, --yes              Assume yes for confirmation prompts

EXAMPLES
  portta bootstrap
  portta up local
  portta urls --project demo-a
  portta doctor --json
  portta remote bootstrap deploy@vps --profile remote-private

Consumer projects are adapted with an overlay file and stay where they are.
See docs/adopting-projects.md.
PORTTA_HELP
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_version() {
  printf 'portta %s\n' "$(portta_version)"
}

cmd_bootstrap() {
  exec "$PORTTA_ROOT/scripts/bootstrap.sh" "$@"
}

cmd_doctor() {
  exec "$PORTTA_ROOT/scripts/doctor.sh" "$@"
}

cmd_up() {
  local profile="${PORTTA_PROFILE}"
  local detach=1
  local local_release=0
  # --wait makes the exit code mean "the gateway came back healthy" rather than
  # "Compose accepted the plan". The applier runs with it, because its exit code
  # is the only account of the apply the panel gets to read.
  local wait=1

  while [ $# -gt 0 ]; do
    case "$1" in
      --attach) detach=0 ;;
      --local-release) local_release=1 ;;
      --wait) wait=1 ;;
      --demo)
        err "'up --demo' requires Node 22.12 or newer and the full CLI"
        hint "npm install -g portta   (or run it inside a built checkout)"
        exit 3
        ;;
      -*) die "unknown flag for 'up': $1" ;;
      *) profile="$1" ;;
    esac
    shift
  done

  portta_require_docker || exit 1
  portta_require_compose || exit 1
  portta_prepare_env || exit 1
  portta_load_env || exit 1
  portta_defaults
  if [ "$local_release" = 1 ]; then
    portta_env_set PORTTA_AUTH_IMAGE "fabioassuncao/portta:$(portta_version)"
    portta_env_set PORTTA_WEB_IMAGE "fabioassuncao/portta:$(portta_version)"
    portta_env_set PORTTA_WEB_BUILD false
    portta_env_set PORTTA_WEB_DEV false
    export PORTTA_LOCAL_RELEASE=true
  fi
  portta_resolve_profile "$profile" || exit 1

  if portta_is_true "${PORTTA_LOCAL_RELEASE:-false}"; then
    local version image missing=""
    version=$(portta_version)
    for image in \
      "fabioassuncao/portta:$version" \
      "fabioassuncao/portta-apply:$version" \
      "fabioassuncao/portta-toolbox:$version"; do
      docker image inspect "$image" >/dev/null 2>&1 || missing="$missing $image"
    done
    if [ -n "$missing" ]; then
      err "local release $version is incomplete; missing:${missing}"
      hint "run just build"
      exit 2
    fi
  fi

  # The shared network must exist before Compose resolves `external: true`.
  portta_network_ensure "$PORTTA_NETWORK" \
    || die "could not create the shared network '$PORTTA_NETWORK'"

  # So must the access network, when databases are routed by hostname. Opted-in
  # datastores join it; the shared HTTP network never carries one.
  if portta_is_true "$PORTTA_TCP"; then
    portta_network_ensure "$PORTTA_ACCESS_NETWORK" \
      || die "could not create the access network '$PORTTA_ACCESS_NETWORK'"
  fi

  mkdir -p "$PORTTA_STATE_DIR/traefik/acme"
  portta_auth_prepare "$profile" || die "authentication state could not be prepared"

  info "starting gateway (profile: $profile, domain: $PORTTA_DOMAIN)"
  if [ "$detach" = "1" ]; then
    if [ "$wait" = "1" ]; then
      portta_compose "$profile" up -d --remove-orphans --wait --wait-timeout 180 || exit 1
    else
      portta_compose "$profile" up -d --remove-orphans
    fi
  else
    portta_compose "$profile" up --remove-orphans
  fi

  # The optional applier, so the panel can recreate these containers itself.
  # Off unless PORTTA_APPLY=true, and never fatal. See scripts/lib/apply.sh.
  portta_apply_ensure
  portta_runner_ensure

  ok "gateway is up"
  hint "portta status shows what is running"
  hint "portta urls lists the hostnames being served"
}

cmd_down() {
  local profile="${PORTTA_PROFILE}"
  local apply_id runner_id
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) shift; profile="${1:-$profile}" ;;
      --demo)
        err "'down --demo' requires Node 22.12 or newer and the full CLI"
        hint "npm install -g portta   (or run it inside a built checkout)"
        exit 3
        ;;
      -*) die "unknown flag for 'down': $1" ;;
      *) profile="$1" ;;
    esac
    shift
  done

  portta_require_docker || exit 1
  portta_resolve_profile "$profile" || exit 1

  info "stopping gateway components"
  # No `--volumes`, no `--remove-orphans`: this must never reach past the
  # gateway's own Compose project.
  portta_compose "$profile" down

  # The applier lives outside that project, so Compose does not see it. `up`
  # recreates it, and leaving a stopped gateway container behind is the one
  # thing `down` does to nothing else.
  apply_id=$(portta_gateway_container apply)
  [ -n "$apply_id" ] && portta_apply_remove "$apply_id" >/dev/null 2>&1
  runner_id=$(portta_gateway_container runner)
  [ -n "$runner_id" ] && portta_runner_remove "$runner_id" >/dev/null 2>&1

  ok "gateway stopped; consumer projects were not touched"
  if portta_network_exists "$PORTTA_NETWORK"; then
    hint "the shared network '$PORTTA_NETWORK' was kept ($(portta_network_endpoints "$PORTTA_NETWORK") container(s) still attached)"
  fi
}

cmd_restart() {
  local profile="${1:-$PORTTA_PROFILE}"
  portta_require_docker || exit 1
  portta_resolve_profile "$profile" || exit 1
  portta_compose "$profile" restart
  ok "gateway restarted; routes are rediscovered automatically"
}

cmd_logs() {
  local profile="${PORTTA_PROFILE}"
  portta_require_docker || exit 1
  portta_resolve_profile "$profile" || exit 1
  portta_compose "$profile" logs -f --tail 100 "$@"
}

cmd_urls() {
  local as_json=0 project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1 ;;
      --project) shift; project="${1:-}" ;;
      --project=*) project="${1#--project=}" ;;
      *) die "unknown argument for 'urls': $1" ;;
    esac
    shift
  done

  portta_require_docker || exit 1
  portta_resolve_profile "$PORTTA_PROFILE" || exit 1

  local scheme="http" rows
  portta_is_true "$TLS_ENABLED" && scheme="https"

  rows=$(portta_discover_http "$project")

  if [ "$as_json" = "1" ]; then
    printf '{\n  "scheme": "%s",\n  "domain": "%s",\n  "routes": [\n' \
      "$scheme" "$(portta_json_escape "$PORTTA_DOMAIN")"
    local first=1 p s c h port state
    while IFS="$(printf '\t')" read -r p s c h port state; do
      [ -n "${p:-}" ] || continue
      [ "$first" = "1" ] || printf ',\n'
      first=0
      printf '    {"project": "%s", "service": "%s", "container": "%s", "url": "%s://%s", "port": "%s", "state": "%s"}' \
        "$(portta_json_escape "$p")" "$(portta_json_escape "$s")" "$(portta_json_escape "$c")" \
        "$scheme" "$(portta_json_escape "$h")" "$(portta_json_escape "$port")" "$(portta_json_escape "$state")"
    done <<EOF
$rows
EOF
    printf '\n  ]\n}\n'
    return 0
  fi

  if [ -z "$rows" ]; then
    warn "no services are currently opted into the gateway"
    hint "a service joins by setting traefik.enable=true and attaching to the '$PORTTA_NETWORK' network"
    hint "see docs/adopting-projects.md"
    return 0
  fi

  printf '%-28s %-14s %s\n' "PROJECT" "SERVICE" "URL"
  printf '%s\n' "$rows" | sort | while IFS="$(printf '\t')" read -r p s _c h _port state; do
    [ -n "${p:-}" ] || continue
    if [ "$state" = "running" ]; then
      printf '%-28s %-14s %s://%s\n' "$p" "$s" "$scheme" "$h"
    else
      printf '%-28s %-14s %s://%s  (%s)\n' "$p" "$s" "$scheme" "$h" "$state"
    fi
  done
}

cmd_status() {
  local as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1 ;;
      *) die "unknown argument for 'status': $1" ;;
    esac
    shift
  done

  portta_require_docker || exit 1
  portta_resolve_profile "$PORTTA_PROFILE" || exit 1

  local traefik_id traefik_state traefik_health proxy_state net_state routes
  traefik_id=$(portta_gateway_container traefik)
  if [ -n "$traefik_id" ]; then
    traefik_state=$(portta_container_state "$traefik_id")
    traefik_health=$(portta_container_health "$traefik_id")
  else
    traefik_state="absent"; traefik_health="none"
  fi

  local proxy_id
  proxy_id=$(portta_gateway_container socket-proxy)
  proxy_state=$([ -n "$proxy_id" ] && portta_container_state "$proxy_id" || printf 'absent')

  if portta_network_exists "$PORTTA_NETWORK"; then
    net_state="present ($(portta_network_endpoints "$PORTTA_NETWORK") attached)"
  else
    net_state="missing"
  fi

  routes=$(portta_discover_http | grep -c . || true)

  if [ "$as_json" = "1" ]; then
    cat <<JSON
{
  "version": "$(portta_version)",
  "profile": "$PORTTA_PROFILE",
  "domain": "$PORTTA_DOMAIN",
  "bind_address": "$PORTTA_BIND_ADDRESS",
  "http_port": "$PORTTA_HTTP_PORT",
  "https_port": "$PORTTA_HTTPS_PORT",
  "tls_enabled": $(portta_is_true "$TLS_ENABLED" && echo true || echo false),
  "tailscale_enabled": $(portta_is_true "$TAILSCALE_ENABLED" && echo true || echo false),
  "public_enabled": $(portta_is_true "$PUBLIC_ENABLED" && echo true || echo false),
  "dashboard_enabled": $(portta_is_true "$PORTTA_DASHBOARD" && echo true || echo false),
  "tcp_enabled": $(portta_is_true "$PORTTA_TCP" && echo true || echo false),
  "tcp_postgres_port": "$PORTTA_TCP_POSTGRES_PORT",
  "tcp_redis_port": "$PORTTA_TCP_REDIS_PORT",
  "web_enabled": $(portta_is_true "$PORTTA_WEB" && echo true || echo false),
  "web_url": "http://$PORTTA_WEB_BIND_ADDRESS:$PORTTA_WEB_PORT",
  "web_expose": "$PORTTA_WEB_EXPOSE",
  "traefik": {"state": "$traefik_state", "health": "$traefik_health"},
  "socket_proxy": {"state": "$proxy_state"},
  "network": {"name": "$PORTTA_NETWORK", "state": "$net_state"},
  "routes": $routes
}
JSON
    return 0
  fi

  printf '%s\n' "$(portta_bold "Portta $(portta_version)")"
  printf '  %-18s %s\n' "profile" "$PORTTA_PROFILE"
  printf '  %-18s %s\n' "domain" "$PORTTA_DOMAIN"
  printf '  %-18s %s:%s (http) / %s (https)\n' "listening" \
    "$PORTTA_BIND_ADDRESS" "$PORTTA_HTTP_PORT" "$PORTTA_HTTPS_PORT"
  printf '  %-18s %s\n' "attachment" "$(portta_attachment "$PORTTA_PROFILE")"
  printf '  %-18s %s\n' "traefik" "$traefik_state ($traefik_health)"
  printf '  %-18s %s\n' "socket proxy" "$proxy_state"
  printf '  %-18s %s %s\n' "network" "$PORTTA_NETWORK" "$net_state"
  printf '  %-18s %s\n' "tls" "$(portta_is_true "$TLS_ENABLED" && printf 'enabled (%s)' "$TLS_MODE" || printf 'disabled')"
  local ts_id ts_line
  ts_id=$(portta_gateway_container tailscale)
  if [ -n "$ts_id" ] && [ "$(portta_container_state "$ts_id")" = "running" ]; then
    ts_line="running $(docker exec "$ts_id" tailscale ip -4 2>/dev/null | head -1)"
  else
    ts_line=$(portta_is_true "$TAILSCALE_ENABLED" && printf 'enabled (not running)' || printf 'disabled')
  fi
  printf '  %-18s %s\n' "tailscale" "$ts_line"
  printf '  %-18s %s\n' "private domain" "${PRIVATE_DOMAIN:-<unset>}"
  printf '  %-18s %s\n' "public domain" "${PUBLIC_DOMAIN:-<unset>}"
  printf '  %-18s %s\n' "public access" "$(portta_is_true "$PUBLIC_ENABLED" && printf 'ENABLED' || printf 'disabled')"
  printf '  %-18s %s\n' "dashboard" "$(portta_is_true "$PORTTA_DASHBOARD" && printf 'enabled (%s:%s)' "$PORTTA_DASHBOARD_BIND_ADDRESS" "$PORTTA_DASHBOARD_PORT" || printf 'disabled')"
  printf '  %-18s %s\n' "tcp routing" "$(portta_is_true "$PORTTA_TCP" && printf 'enabled (postgres :%s, redis :%s)' "$PORTTA_TCP_POSTGRES_PORT" "$PORTTA_TCP_REDIS_PORT" || printf 'disabled')"
  printf '  %-18s %s\n' "web panel" "$(portta_is_true "$PORTTA_WEB" && printf 'enabled (%s:%s, expose: %s)' "$PORTTA_WEB_BIND_ADDRESS" "$PORTTA_WEB_PORT" "$PORTTA_WEB_EXPOSE" || printf 'disabled')"
  printf '  %-18s %s\n' "routed services" "$routes"
}

cmd_inspect() {
  portta_resolve_profile "$PORTTA_PROFILE" || exit 1
  printf '%s\n' "$(portta_bold 'Resolved configuration')"
  local v
  for v in PORTTA_PROFILE PORTTA_PROJECT_NAME PORTTA_NETWORK \
           PORTTA_CONTROL_NETWORK PORTTA_ACCESS_NETWORK \
           PORTTA_DOMAIN PORTTA_BIND_ADDRESS PORTTA_HTTP_PORT \
           PORTTA_HTTPS_PORT PORTTA_LOG_LEVEL PORTTA_ACCESS_LOG \
           PORTTA_DASHBOARD PORTTA_WEB PORTTA_WEB_BIND_ADDRESS \
           PORTTA_WEB_PORT PORTTA_WEB_EXPOSE PORTTA_WEB_DEV \
           PORTTA_WEB_READ_ONLY PORTTA_TCP \
           PORTTA_TCP_POSTGRES_PORT PORTTA_TCP_REDIS_PORT \
           TLS_ENABLED TLS_MODE TAILSCALE_ENABLED \
           PUBLIC_ENABLED PUBLIC_DOMAIN PRIVATE_DOMAIN CLOUDFLARE_ENABLED; do
    printf '  %-32s %s\n' "$v" "${!v:-}"
  done

  printf '\n%s\n' "$(portta_bold 'Compose files')"
  local files
  files=$(portta_compose_files "$PORTTA_PROFILE") || exit 1
  printf '%s\n' "$files" | tr ' ' '\n' | grep -v '^-f$' | sed 's#^#  #'

  printf '\n%s\n' "$(portta_bold 'Secrets')"
  printf '  %-32s %s\n' "TS_AUTHKEY" "$([ -n "${TS_AUTHKEY:-}" ] && printf '<set>' || printf '<unset>')"
  printf '  %-32s %s\n' "CF_DNS_API_TOKEN" "$([ -n "${CF_DNS_API_TOKEN:-}" ] && printf '<set>' || printf '<unset>')"
}

cmd_update() {
  portta_prepare_env || exit 1
  portta_load_env || exit 1
  portta_defaults
  local profile="${PORTTA_PROFILE}"
  portta_require_docker || exit 1
  portta_resolve_profile "$profile" || exit 1

  info "validating the compose configuration before touching anything"
  portta_compose "$profile" config --quiet || die "compose configuration is invalid; nothing was changed"

  # --ignore-buildable because an explicit build overlay gives the auth
  # services a `build:` and a local tag. Without it Compose tries to pull an
  # image that only exists after `docker compose build`, and the registry it was
  # never pushed to answers "access denied".
  info "pulling pinned component images"
  portta_compose "$profile" pull --ignore-buildable

  portta_confirm "Recreate gateway containers now? Consumer projects are unaffected." || {
    info "aborted; images were pulled but nothing was recreated"
    return 0
  }

  portta_compose "$profile" up -d --remove-orphans --wait --wait-timeout 180
  ok "gateway updated"
  hint "run 'portta doctor' to confirm the new components are healthy"
}

cmd_toolbox() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    build)
      portta_require_docker || exit 1
      info "building $PORTTA_TOOLBOX_IMAGE"
      docker build --build-arg "PORTTA_VERSION=$(portta_version)" -t "$PORTTA_TOOLBOX_IMAGE" "$PORTTA_TOOLBOX_CONTEXT" || die "build failed"
      ok "toolbox ready"
      ;;
    run)
      portta_require_docker || exit 1
      case "${1:-}" in --) shift ;; esac
      [ $# -gt 0 ] || die "no command given"
      portta_toolbox_online "$@"
      ;;
    ''|-h|--help|help)
      cat >&2 <<'PORTTA_HELP'
portta toolbox: containerised tooling

  toolbox build          Build the image (done automatically on first use)
  toolbox run -- <cmd>   Run a command inside it

Holds curl, jq, dig, openssl, socat, nc, ssh, psql, mysql and redis-cli, so the
host itself only needs Docker, Git and a shell.
PORTTA_HELP
      ;;
    *) die "unknown toolbox subcommand: $sub" ;;
  esac
}

# ---------------------------------------------------------------------------
# Per-command help
# ---------------------------------------------------------------------------
# The subcommand groups (access, dns, public, ...) carry their own help. These
# are the flat commands, so that `--help` works the same everywhere.

cmd_help_for() {
  case "$1" in
    up) cat >&2 <<'PORTTA_HELP'
portta up [profile]: start the gateway

  profile     local | remote-private | remote-public
              (default: PORTTA_PROFILE, or `local`)
  --attach    Run in the foreground and stream logs
  --wait      Exit only once every component is healthy, or fail after 180s

Creates the shared network if it is missing, then starts Traefik and the
socket proxy. Consumer projects are never started or stopped by this.

With PORTTA_APPLY=true this also prepares the applier: a stopped, single-purpose
container the panel may start to run this command for you. See
docs/adr/0026-applying-settings-from-the-panel.md.
PORTTA_HELP
      ;;
    down) cat >&2 <<'PORTTA_HELP'
portta down: stop the gateway

Stops Traefik and the socket proxy, and removes the applier when there is one.
Applications keep running, the shared network is kept because other projects are
attached to it, and no volume is ever removed.
PORTTA_HELP
      ;;
    restart) cat >&2 <<'PORTTA_HELP'
portta restart [profile]: restart gateway components

Applications are not restarted. Traefik rediscovers every route on its own
once it is back.
PORTTA_HELP
      ;;
    status) cat >&2 <<'PORTTA_HELP'
portta status: compact overview

  --json    Machine-readable output

Profile, domain, listeners, component health, the shared network, TLS,
Tailscale, public access, and how many services are routed.
PORTTA_HELP
      ;;
    logs) cat >&2 <<'PORTTA_HELP'
portta logs [service]: follow gateway logs

  service   traefik | socket-proxy | tailscale (default: all)

Only gateway components. A project's logs come from its own directory.
PORTTA_HELP
      ;;
    urls) cat >&2 <<'PORTTA_HELP'
portta urls: the hostnames currently being served

  --project <name>   Only this project
  --json             Machine-readable output

Read from Docker labels, so it works with the dashboard off and even while
Traefik is down.
PORTTA_HELP
      ;;
    inspect) cat >&2 <<'PORTTA_HELP'
portta inspect: the resolved configuration

Every setting after .env, the shell environment and the built-in defaults have
been applied, plus the compose files the active profile selects. Secrets are
shown as <set> or <unset>, never by value.
PORTTA_HELP
      ;;
    update) cat >&2 <<'PORTTA_HELP'
portta update: pull the pinned images and recreate

Validates the compose configuration before touching anything, pulls, then asks
before recreating. State under ./state is left alone, including ACME
certificates and the Tailscale identity.
PORTTA_HELP
      ;;
    version) cat >&2 <<'PORTTA_HELP'
portta version: print the gateway version
PORTTA_HELP
      ;;
    *) return 1 ;;
  esac
  return 0
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift || true

  # Global flags that may precede the command.
  while [ "${cmd:-}" != "" ]; do
    case "$cmd" in
      -h|--help|help) usage; exit 0 ;;
      -V|--version) cmd_version; exit 0 ;;
      -y|--yes) PORTTA_ASSUME_YES=true; cmd="${1:-}"; [ $# -gt 0 ] && shift || true ;;
      --profile) PORTTA_PROFILE="${1:-}"; shift; cmd="${1:-}"; [ $# -gt 0 ] && shift || true ;;
      *) break ;;
    esac
  done
  export PORTTA_ASSUME_YES PORTTA_PROFILE

  # `--help` behaves the same for every command. The subcommand groups parse
  # it themselves; these are the flat ones.
  case " $* " in
    *" --help "*|*" -h "*)
      if cmd_help_for "${cmd:-}"; then exit 0; fi
      ;;
  esac

  case "${cmd:-}" in
    ''|help) usage; exit 0 ;;
    version) cmd_version "$@" ;;
    bootstrap) cmd_bootstrap "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    doctor) cmd_doctor "$@" ;;
    restart) cmd_restart "$@" ;;
    logs) cmd_logs "$@" ;;
    urls) cmd_urls "$@" ;;
    inspect) cmd_inspect "$@" ;;
    update) cmd_update "$@" ;;
    toolbox) cmd_toolbox "$@" ;;
    # Names the full CLI implements. Reporting the requirement beats an
    # `unknown command` a reader would have to disprove. Every name here is
    # registered in the Commander tree, and `tests/unit/cli.test.sh` fails if
    # one stops being: a spelling only this list knows is a command that does
    # not exist on any host with Node, which is every host the installer
    # touched. `analyse` and `adapt` were exactly that.
    build|tls|tunnel|remote|backup|restore|repair|network|public|dns|analyze|init|namespace|ns|access|services|git|repos|host|share|auth|web|db|redis|service|setup|config|dev|reset|tasks|sessions|activity|projects|envs|env|overview|examples)
      err "'$cmd' requires Node 22.12 or newer and the full CLI"
      hint "npm install -g portta   (or run it inside a built checkout)"
      exit 3
      ;;
    *)
      err "unknown command: $cmd"
      hint "run 'portta --help' for the command list"
      exit 1
      ;;
  esac
}

main "$@"
