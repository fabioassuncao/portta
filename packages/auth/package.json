{
  "name": "portta-auth-core",
  "version": "0.1.0",
  "private": true,
  "description": "Who is asking, and what they may do",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./src/hono.ts",
      "development": "./src/hono.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.2",
    "better-auth": "1.7.2",
    "nanoid": "5.1.16",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "portta-db": "0.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.3",
    "hono": "4.13.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
