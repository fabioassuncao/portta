{
  "name": "portta-server",
  "version": "0.1.0",
  "private": true,
  "description": "The panel's services, HTTP API and background work",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/standard-validator": "0.2.0",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.9",
    "@types/json-schema": "7.0.15",
    "hono": "4.13.5",
    "hono-openapi": "1.3.1",
    "openapi-types": "12.1.3",
    "portta-auth-core": "0.1.0",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "portta-db": "0.1.0",
    "postgres": "3.4.9",
    "ws": "8.19.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
